# Copy to .env.local and fill in. Either key is enough; set both to get both
# providers' models in the picker.

# Google - get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Google image model to use by default.
#   gemini-3.1-flash-image  (fast image editing - current default)
#   gemini-3-pro-image      (higher quality, slower)
#   gemini-2.5-flash-image  (older, cheaper)
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI - get a key at https://platform.openai.com/api-keys
# The picker lists every gpt-image-* model the key can reach.
OPENAI_API_KEY=
